# Banco — PostgreSQL 16, decisão de infra fixa. Ver .claude/rules/db.md
# Sobe sozinho: `docker compose -f docker/postgres.yml up -d`.
DATABASE_URL="postgresql://user:password@localhost:5432/spokke"

# Auth — Better Auth. Gere um segredo forte: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:5173"

# Cobrança — docs/adr-002-billing.md e docs/operacao.md "Mercado Pago".
# Vazio ou "manual": "Assinar" vira um PEDIDO que a equipe atende no painel.
# "mercadopago": o checkout do Mercado Pago, e o webhook ativa o plano. Sem o
# token, "mercadopago" falha alto em vez de cair no manual.
BILLING_PROVIDER=""
# Credenciais de produção (APP_USR-...) ou de teste, em "Suas integrações" no
# painel do Mercado Pago. O worker também precisa delas: é ele quem processa o webhook.
MERCADOPAGO_ACCESS_TOKEN=""
# A "assinatura secreta" dos webhooks (Suas integrações › Webhooks). Sem ela o
# endpoint /api/mercadopago responde 503 — notificação sem conferir não entra.
MERCADOPAGO_WEBHOOK_SECRET=""

# Painel interno (/admin) — IDs de Teacher, separados por vírgula. IDs e NÃO
# e-mails: o cadastro não verifica e-mail. Crie a sua conta, copie o id dela
# (Prisma Studio ou `SELECT id FROM "Teacher" WHERE email = '...'`) e cole aqui.
PLATFORM_ADMIN_IDS=""

# Para onde vão os avisos da equipe: pedidos de plano e o formulário de contato.
# Vazio = vão para o log do worker.
CONTATO_PARA=""

# IA — "Gerar com IA" (docs/adr-003-ia-gemini.md). Vazio = desligada: o botão
# fica travado com o motivo escrito. GEMINI_MODEL é o id do modelo (escolha o
# Flash estável vigente em ai.google.dev/gemini-api/docs/models). Use uma chave
# de projeto COM FATURAMENTO: a política de privacidade promete que os dados
# não são usados para treinamento, o que não vale na camada gratuita.
LLM_PROVIDER=""
GEMINI_API_KEY=""
GEMINI_MODEL=""

# Worker — quantos jobs em paralelo. Ajuda e-mail (espera de rede), não TTS.
WORKER_CONCURRENCY="3"

# Mídia — object storage S3-compatível. Em dev é o MinIO de
# `docker/minio.yml` (`docker compose -f docker/minio.yml up -d`); em produção,
# preferir R2 (sem cobrança de egress: áudio é servido em toda questão de
# escuta). Ver .claude/rules/server.md "Mídia".
#
# Os valores abaixo são os PADRÕES do compose — mudar aqui exige mudar lá, e é
# por isso que o compose lê estas mesmas variáveis.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_BUCKET="spokke-midia"
STORAGE_ACCESS_KEY_ID="spokke"
STORAGE_SECRET_ACCESS_KEY="spokke-dev-secret"
# O endereço por onde o BROWSER do aluno baixa o áudio — inclui o bucket, porque
# o MinIO só responde no estilo path.
STORAGE_PUBLIC_URL="http://localhost:9000/spokke-midia"

# O áudio de uma atividade vive 10 DIAS. Quem apaga é a regra de ciclo de vida
# do próprio MinIO (o container `init` de docker/minio.yml a escreve no `tts/`); o
# prazo do lado de cá é `TTS_DIAS_DE_VIDA`, em `src/lib/server/tts/index.ts`.
# Os dois têm de bater — não existe variável para isso justamente porque um
# .env divergente deixaria o banco apontando para objeto que já sumiu.

# TTS e ASR — `audiotext` é o microserviço de Whisper + Kokoro
# (../audiotext-service). Vazio significa OMITIR: sem TTS não sai item de
# escuta, sem ASR não sai item de fala. `TTS_PROVIDER=stub` gera um WAV
# silencioso, só para exercitar a fila sem subir o serviço de áudio.
TTS_PROVIDER="audiotext"
ASR_PROVIDER="audiotext"

# Tradução do MATERIAL — o tradutor do mesmo serviço de áudio (MADLAD-400 3B,
# docs/adr-006-traducao.md). Ligado, o professor cadastra a frase no idioma que
# ensina e a tradução para a língua do aluno sai sozinha: sugerida enquanto ele
# digita e feita ao salvar o que veio em branco. Ele confere e ajusta; a que ele
# escreve nunca é trocada. Vazio desliga, e a tela pede a tradução como sempre.
TRANSLATE_PROVIDER="audiotext"

# O microserviço de áudio. A porta é a do compose de lá (AUDIOTEXT_PORT, 8080
# por padrão). O token é opcional em dev; com AUDIOTEXT_API_TOKEN definido lá,
# ele é obrigatório aqui.
AUDIOTEXT_URL="http://localhost:8080"
AUDIOTEXT_TOKEN=""

# E-mail — convites (aluno, módulo, escola) e avisos à equipe.
#
# Vazio (ou "log") NÃO envia: registra no log do servidor com o link inteiro,
# que é o bastante para percorrer o fluxo em dev sem depender de nada. "smtp"
# manda de verdade.
#
# SMTP e não a API de um provedor porque todo serviço fala SMTP, e trocar de
# fornecedor vira uma linha de configuração. O escolhido é o **Resend**:
#
#   SMTP_URL="smtps://resend:re_SUA_CHAVE@smtp.resend.com:465"
#
# O usuário é literalmente "resend"; a senha é a API key. Outros, se um dia:
#   Brevo:  smtp://usuario:chave@smtp-relay.brevo.com:587
#   Gmail:  smtps://voce@gmail.com:SENHA_DE_APP@smtp.gmail.com:465
#
# **EMAIL_FROM precisa ser do domínio VERIFICADO no provedor.** É a causa nº 1
# de "configurei e não sai". O plano grátis do Resend dá 3.000/mês, 100/dia e
# até 3 domínios; sem verificar nenhum, ele só entrega para o e-mail da própria
# conta — e aí o remetente é o compartilhado `onboarding@resend.dev`.
#
# O DNS do domínio precisa de SPF, DKIM e DMARC — o provedor mostra os três
# registros. Eles ficam no domínio, não no servidor.
EMAIL_PROVIDER=""
SMTP_URL=""
EMAIL_FROM="Spokke <nao-responda@exemplo.com>"

# ---------------------------------------------------------------------------
# Só para rodar a APLICAÇÃO em container (`docker compose up -d --build`).
#
# Tudo acima é o endereço de quem roda no HOST (`pnpm dev`), e `localhost`
# dentro de um container é o próprio container. O compose sobrescreve estes três
# com `host.docker.internal`; as linhas abaixo existem para você poder apontar
# para outro lugar sem editar o compose. Deixar em branco usa o padrão.
#
# `STORAGE_PUBLIC_URL` NÃO tem par aqui de propósito: ela é o endereço que vai
# no <audio> do aluno e quem resolve é o browser DELE.
DATABASE_URL_DOCKER=""
STORAGE_ENDPOINT_DOCKER=""
AUDIOTEXT_URL_DOCKER=""

# A porta e o endereço público da aplicação em container. `ORIGIN` sai daqui e
# é obrigatório: sem ele o adapter-node recusa todo POST ("cross-site form
# submission forbidden") e o login para de funcionar.
APP_PORT="3000"
APP_ORIGIN="http://localhost:3000"
