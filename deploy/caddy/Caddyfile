# O Caddy da frente do Spokke — docs/deploy.md.
#
# Três endereços: o site, o www (que só redireciona) e a mídia. O certificado de
# cada um sai sozinho do Let's Encrypt na primeira visita, com TLS 1.2 e 1.3 —
# é o que dá a nota A do SSL Labs (docs/selos-e-seguranca.md "5b").

{
	email {$ACME_EMAIL}
}

# Cabeçalhos de segurança dos dois domínios. O app não manda nenhum: moram aqui.
# HSTS de seis meses com subdomínios, como pede o selo do SSL Labs — todo
# subdomínio do spokke.com.br passa a ser só HTTPS. CSP fica para depois do
# lançamento, pela configuração do SvelteKit (`kit.csp`), que sabe o hash do
# script de tema que roda antes da primeira pintura (docs/deploy.md "Depois").
(seguranca) {
	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

spokke.com.br {
	import seguranca
	header {
		X-Frame-Options "SAMEORIGIN"
		# O microfone fica liberado para o próprio site: a questão de fala grava a
		# voz do aluno. Câmera e localização, nunca.
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
	}
	encode zstd gzip
	# O adapter-node lê o IP do aluno do X-Forwarded-For (ADDRESS_HEADER e
	# XFF_DEPTH=1 no .env), que o Caddy escreve com o endereço de quem chegou —
	# sem isso os limites por IP do exemplo, do contato e dos relatos veriam todo
	# mundo como um só.
	reverse_proxy spokke-web:3000
}

www.spokke.com.br {
	redir https://spokke.com.br{uri} permanent
}

# O áudio das atividades, baixado pelo navegador do aluno. Só GET e HEAD, e só em
# `tts/`: a voz dos alunos (`fala/`) também mora no bucket, mas quem a serve é
# uma rota do Studio que confere o professor — aqui ela não passa nem com o
# endereço certo. A API S3 inteira fica sem rota.
midia.spokke.com.br {
	import seguranca
	@audio {
		method GET HEAD
		path /spokke-midia/tts/*
	}
	handle @audio {
		reverse_proxy spokke-minio:9000
	}
	handle {
		respond 404
	}
}
