# O ambiente do banco e do MinIO em PRODUÇÃO — docs/deploy.md.
# No servidor: cp spokke-service/deploy/env/infra.env.exemplo /srv/spokke/env/infra.env
#              chmod 600 /srv/spokke/env/infra.env
# Passado EXPLICITAMENTE nos comandos (`--env-file ../env/infra.env`): os composes
# de docker/ leriam o .env da pasta docker/, que não existe.

# ------------------------------------------------------------------ PostgreSQL
# A senha só vale na PRIMEIRA subida (o Postgres a grava ao criar o volume).
# Trocar depois é ALTER USER dentro do banco, não esta linha.
POSTGRES_USER="spokke"
POSTGRES_PASSWORD="TROCAR"
POSTGRES_DB="spokke"
# Presa ao 127.0.0.1: o banco nunca responde para fora do servidor.
POSTGRES_PORT="127.0.0.1:5432"

# ------------------------------------------------------------------ MinIO
# Usuário e senha-raiz do MinIO — os mesmos STORAGE_ACCESS_KEY_ID e
# STORAGE_SECRET_ACCESS_KEY do .env da aplicação.
STORAGE_ACCESS_KEY_ID="spokke"
STORAGE_SECRET_ACCESS_KEY="TROCAR"
STORAGE_BUCKET="spokke-midia"
STORAGE_PORT="127.0.0.1:9000"
STORAGE_CONSOLE_PORT="127.0.0.1:9001"
