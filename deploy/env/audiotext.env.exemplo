# O .env DE PRODUÇÃO do serviço de áudio (../audiotext-service) — docs/deploy.md.
# No servidor: cp spokke-service/deploy/env/audiotext.env.exemplo audiotext-service/.env
#              chmod 600 audiotext-service/.env

# OBRIGATÓRIO em produção. Vazio, o serviço atende qualquer um — e ele
# transporta a voz de aluno. O mesmo valor vai no AUDIOTEXT_TOKEN da aplicação.
# openssl rand -hex 32
AUDIOTEXT_API_TOKEN="TROCAR"

# Presa ao 127.0.0.1: a aplicação chega pela rede `spokke` (audiotext:8000).
AUDIOTEXT_PORT="127.0.0.1:8080"

# O alvo é CPU (4 vCPU, sem placa): `small` em int8, medido. Subir de degrau é
# esta linha — e uma máquina maior.
AUDIOTEXT_WHISPER_MODEL="small"

# O tradutor do material (MADLAD-400 3B, ~3 GB de memória).
AUDIOTEXT_TRADUCAO_LIGADA="true"

AUDIOTEXT_LOG_LEVEL="INFO"
