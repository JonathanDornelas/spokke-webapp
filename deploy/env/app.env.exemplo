# O .env DE PRODUÇÃO da aplicação (web + worker) — docs/deploy.md.
# No servidor: cp deploy/env/app.env.exemplo .env && chmod 600 .env
# Tudo que diz TROCAR precisa de valor. O resto já está no valor de produção.
# Senhas que entram em URL (banco): gere com `openssl rand -hex 24` — só letras e
# números, nada que precise de escape.

# ------------------------------------------------------------------ endereço
# A origem pública. Vira o ORIGIN do adapter-node (sem ela todo POST é recusado)
# e o BETTER_AUTH_URL (os links de e-mail e a volta do Google saem dela).
APP_ORIGIN="https://spokke.com.br"
BETTER_AUTH_URL="https://spokke.com.br"
# Presa ao 127.0.0.1: quem atende a internet é o Caddy, pela rede `spokke`.
APP_PORT="127.0.0.1:3000"
# Atrás do Caddy, o IP do aluno vem do cabeçalho. Sem estas duas, os limites por
# IP (exemplo, contato, relatos) enxergam todo mundo como o IP do proxy.
ADDRESS_HEADER="X-Forwarded-For"
XFF_DEPTH="1"
# O teto de corpo do adapter-node é 512 KB por padrão; a gravação do aluno tem o
# dela, de 10 MB (a/[slug]/fala), e quem decide tem de ser a rota, com a
# mensagem dela — não um 413 do adapter antes de chegar lá. A fala de um vídeo
# no "Gerar com IA" (materiais/ia/arquivo) chega a 9,6 MB em dez minutos: abaixo
# de 10M, esse envio quebra.
BODY_SIZE_LIMIT="10M"

# ------------------------------------------------------------------ segredos
# openssl rand -base64 32 — um só, de produção, nunca o de desenvolvimento.
BETTER_AUTH_SECRET="TROCAR"

# ------------------------------------------------------------------ banco
# A mesma senha do POSTGRES_PASSWORD do env/infra.env.
# DATABASE_URL é para comando rodado no HOST; o container usa a _DOCKER.
DATABASE_URL="postgresql://spokke:TROCAR@127.0.0.1:5432/spokke"
DATABASE_URL_DOCKER="postgresql://spokke:TROCAR@spokke-postgres:5432/spokke"

# ------------------------------------------------------------------ mídia
# MinIO neste servidor (docker/minio.yml), atrás do Caddy. A chave e o segredo
# são os do env/infra.env (STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY).
STORAGE_ENDPOINT="http://127.0.0.1:9000"
STORAGE_ENDPOINT_DOCKER="http://spokke-minio:9000"
STORAGE_REGION="auto"
STORAGE_BUCKET="spokke-midia"
STORAGE_ACCESS_KEY_ID="spokke"
STORAGE_SECRET_ACCESS_KEY="TROCAR"
# O endereço que vai no <audio> do aluno. É gravado INTEIRO em MediaAsset.url,
# então tem de nascer certo: trocar depois é um UPDATE no banco.
STORAGE_PUBLIC_URL="https://midia.spokke.com.br/spokke-midia"

# ------------------------------------------------------------------ áudio
TTS_PROVIDER="audiotext"
ASR_PROVIDER="audiotext"
TRANSLATE_PROVIDER="audiotext"
AUDIOTEXT_URL="http://127.0.0.1:8080"
# Dentro da rede `spokke`, a porta do CONTAINER (8000), não a do host.
AUDIOTEXT_URL_DOCKER="http://audiotext:8000"
# O mesmo valor do AUDIOTEXT_API_TOKEN do .env do audiotext-service.
AUDIOTEXT_TOKEN="TROCAR"

# ------------------------------------------------------------------ e-mail
# Resend, com o domínio spokke.com.br VERIFICADO (senão ele só entrega para o
# e-mail da própria conta). O usuário do SMTP é literalmente "resend".
EMAIL_PROVIDER="smtp"
SMTP_URL="smtps://resend:re_TROCAR@smtp.resend.com:465"
EMAIL_FROM="Spokke <nao-responda@spokke.com.br>"
# A caixa da equipe: pedidos de plano, contato e relatos de problema.
CONTATO_PARA="TROCAR@spokke.com.br"

# ------------------------------------------------------------------ painel interno
# Ids de Teacher, separados por vírgula — preencha DEPOIS de criar a sua conta no
# site (docs/deploy.md "O primeiro admin"). Vazio, /admin responde 404 a todos.
PLATFORM_ADMIN_IDS=""

# ------------------------------------------------------------------ cobrança
# Vazio no lançamento: "Assinar" vira um pedido atendido no /admin. O Mercado
# Pago liga depois do teste no sandbox (docs/deploy.md "Mercado Pago").
BILLING_PROVIDER=""
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ------------------------------------------------------------------ Google
# Login com o Google: cliente OAuth "Aplicativo da Web" com as duas URLs de
# retorno (docs/deploy.md). Vazio, o botão não aparece.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Google Analytics 4 ("G-..."). Lido em tempo de execução: liga sem rebuild.
PUBLIC_GA_ID=""
# Só se o Search Console for verificado pela meta tag (o caminho do roteiro é o DNS).
PUBLIC_GOOGLE_SITE_VERIFICATION=""
PUBLIC_BING_SITE_VERIFICATION=""

# ------------------------------------------------------------------ IA
# "Gerar com IA". LLM_PROVIDER é a fila, em ordem: "claude,gemini" tenta o
# Claude e, se ele falhar (sem créditos, sobrecarga), o Gemini. Chaves de conta
# COM faturamento (a política promete que os dados não treinam modelo). Vazio,
# o botão fica travado com o motivo escrito.
LLM_PROVIDER=""
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# ------------------------------------------------------------------ worker
WORKER_CONCURRENCY="3"
