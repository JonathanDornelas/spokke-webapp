generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (Better Auth, adapter Prisma) — ver .claude/rules/auth.md
// `Teacher` é o modelo de usuário do Better Auth (renomeado via `user.modelName`
// em $lib/server/auth). Os campos de billing vivem aqui porque são o estado de
// acesso do professor — ver .claude/rules/billing.md "Entitlements".
// ---------------------------------------------------------------------------

model Teacher {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// O avatar, como DEZOITO NÚMEROS separados por hífen — nunca uma imagem
  /// (ver `$lib/avatar/montar.ts`). Cabe numa coluna de texto, viaja no `load`
  /// sem custo e não precisa de bucket nem de regra de ciclo de vida. Nulo é o
  /// normal: quem nunca abriu o editor aparece pelas iniciais.
  ///
  /// Separado de `image`, que é do Better Auth e guarda URL: os dois significam
  /// coisas diferentes, e reaproveitar aquele campo faria o adapter tentar
  /// carregar "1-2-1-..." como endereço.
  avatar String?

  /// Os idiomas que o professor ENSINA (tags de LanguageProfile, `$lib/idiomas.ts`).
  /// Não muda nada do que ele pode fazer: é o PADRÃO da atividade nova, da turma
  /// nova e da biblioteca — sem isso, toda atividade nascia em "Inglês (EUA)".
  /// Opcional; vazio é o estado de quem não respondeu.
  idiomas         String[] @default([])
  /// A língua dos alunos — a "língua do aluno" padrão da atividade nova
  /// (traduções e enunciados). Português para quase todo mundo; outra para quem
  /// ensina português a estrangeiros.
  idiomaDosAlunos String   @default("pt-BR")

  /// O NOSSO id de plano (`basico` | `pro` | `super`, `$lib/billing/catalogo.ts`).
  /// `scholar` nunca é gravado aqui: ele vem da filiação à escola. Quem escreve
  /// estes campos é só `$lib/server/billing/assinaturas.ts` (docs/adr-002-billing.md).
  plan               String?
  subscriptionStatus String?
  currentPeriodEnd   DateTime?
  gracePeriodEnd     DateTime?

  /// Fim do trial. A situação "expirada" é DERIVADA desta data na leitura
  /// (`entitlements.ts`), não escrita por um job que pudesse esquecer de rodar.
  trialEndsAt       DateTime?
  /// `mensal` | `anual` — o ciclo de COBRANÇA. Créditos renovam todo mês nos dois.
  planCycle         String?
  /// Âncora do ciclo mensal de créditos: o dia em que o plano foi ativado.
  cycleAnchor       DateTime?
  /// Cancelada "no fim do período": continua valendo até `currentPeriodEnd`.
  cancelAtPeriodEnd Boolean   @default(false)

  sessions              Session[]
  accounts              Account[]
  activities            Activity[]
  contentUnits          ContentUnit[]
  mediaAssets           MediaAsset[]
  classrooms            Classroom[]
  students              Student[]
  auditEvents           AuditEvent[]
  planRequests          PlanRequest[]
  creditEntries         CreditEntry[]
  modules               Module[]
  notifications         Notification[]
  providerSubscriptions ProviderSubscription[]
  /// Os relatos de problema que alunos mandaram das atividades dele.
  problemReports        ProblemReport[]
  /// A escola de que o professor faz parte, quando faz (uma por vez).
  schoolMembership      SchoolMembership?
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  teacher Teacher @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  providerId            String
  issuer                String
  accountId             String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId  String
  teacher Teacher @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Conta do ALUNO — opcional, e separada da do professor de propósito.
//
// O produto continua funcionando sem conta nenhuma: o aluno abre o link,
// digita o nome e responde. A conta existe só para ele guardar o histórico
// dele e reencontrá-lo em outro aparelho — nunca para destravar a atividade.
//
// Tabelas próprias, e não um campo `role` na `Teacher`: professor tem
// assinatura, atividades e turmas penduradas nele, e uma sessão de aluno
// jamais pode virar sessão de professor por um bug de escopo. São duas
// instâncias de Better Auth, cada uma com o seu conjunto de tabelas — o hash
// de senha e a sessão continuam sendo da biblioteca (auth.md).
// ---------------------------------------------------------------------------

model StudentAccount {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// O avatar do aluno — mesma forma e mesmo porquê do `Teacher.avatar`. Aqui
  /// ele tem um uso a mais: é o que a turma vê ao lado do nome dele, e é a
  /// única coisa da conta do aluno que ele escolhe por gosto.
  avatar String?

  sessions    StudentSession[]
  credentials StudentCredential[]

  /// As fichas de chamada ligadas a esta pessoa. Uma por turma: o mesmo aluno
  /// em dois cursos do mesmo professor são dois cadastros, e continuam sendo.
  roster   Student[]
  attempts Attempt[]
}

model StudentSession {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId  String
  account StudentAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudentCredential {
  id                    String    @id
  providerId            String
  issuer                String
  accountId             String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId  String
  account StudentAccount @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudentVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------------------------------------------------------------------------
// Conteúdo e atividades — ver .claude/rules/kernel.md e .claude/rules/db.md
// ---------------------------------------------------------------------------

model ContentUnit {
  id   String @id @default(cuid())
  kind String // SentencePair | VocabItem | Passage | Dialogue
  data Json // formato depende de `kind` — valide com Zod ao ler, nunca confie no tipo do Prisma

  /// A TAG DE IDIOMA do material: o idioma alvo (tag de `LanguageProfile`),
  /// nulo = "sem idioma". Dentro de uma atividade ele é o dela; na biblioteca,
  /// o professor escolhe (`$lib/idiomas.ts`). Validado ao ler (`idiomaOuNulo`).
  targetLang String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  /// Em quais atividades este material está sendo usado. É N:N porque o
  /// material entra na BIBLIOTECA do professor e pode ser reusado em outra
  /// atividade (paginas.md "Materiais"); sem isto, "materiais desta
  /// atividade" mostraria a biblioteca inteira.
  activities Activity[] @relation("AtividadeMaterial")

  @@index([teacherId])
  @@index([teacherId, targetLang])
}

model MediaAsset {
  id       String @id @default(cuid())
  hash     String
  url      String
  kind     String // audio | image
  duration Int? // segundos, só para áudio

  createdAt DateTime @default(now())

  /// **O áudio de atividade não vence.** Ele vivia 10 dias (regra de ciclo de
  /// vida do bucket + uma coluna `expiresAt` espelhando a data), e a entrada do
  /// Player resintetizava o que tinha vencido. Com o limite de atividades por
  /// plano o estoque é finito, então o arquivo fica enquanto alguma atividade
  /// do professor o usa — e sai quando a última delas é apagada
  /// (`server/tts/limpeza.ts`). A gravação de voz do ALUNO continua com 7 dias.

  /// **O áudio não tem dono além do PROFESSOR.**
  ///
  /// O dono já foi o hash global, depois a atividade, depois o material. O
  /// material parecia certo — é de onde o texto sai — mas ele é só um
  /// FACILITADOR de montagem: apagar um da biblioteca derrubava o áudio de uma
  /// atividade no ar, e nem uma referência solta conserta o mal-entendido de
  /// fundo, que é a atividade depender de algo que o professor pode jogar fora.
  ///
  /// Agora a identidade é só o conteúdo: `hash(texto, voz, velocidade)`, único
  /// por professor. A mesma frase em dois materiais é UM arquivo; apagar
  /// material não alcança nada; e regerar funciona sempre, porque o texto está
  /// congelado no item.

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  /// O hash é único por PROFESSOR: é ele que torna a geração idempotente
  /// (rodar o job duas vezes reescreve o mesmo objeto) e o reuso automático
  /// (a mesma frase noutra atividade não paga síntese de novo).
  @@unique([teacherId, hash])
}

model Activity {
  id    String @id @default(cuid())
  title String

  /// Tags de LanguageProfile (kernel/language/profiles). O par é escolhido na
  /// etapa 1 do wizard e define tokenização, direção do texto e normalização —
  /// por isso mora na atividade, não em cada item.
  sourceLang String @default("pt-BR")
  targetLang String @default("en-US")

  /// Quantas questões gerar, escolhido na etapa 1. Teto de 15 por atividade:
  /// acima disso o aluno abandona no meio e o relatório do professor fica pela
  /// metade. Não é o número de itens FINAL — o professor ainda descarta na
  /// revisão —, é o alvo que os geradores tentam alcançar.
  itemTarget Int @default(12)

  /// Quais habilidades o professor quer nesta atividade. Ele não marca a
  /// habilidade de cada item (ela é DERIVADA — kernel.md), mas escolhe o que a
  /// atividade treina, e o gerador filtra o que produziu. Vazio = todas as
  /// disponíveis.
  skills String[] @default(["listening", "speaking", "reading", "writing"])

  /// Arquivada: sai do estoque do plano (libera a vaga) e o link FECHA para
  /// quem ainda não começou — quem já está respondendo termina, e os resultados
  /// ficam. É o jeito de liberar espaço sem apagar o que a turma fez
  /// (docs/adr-002-billing.md). Nulo é o normal.
  archivedAt DateTime?

  /// O NÍVEL que o professor dá à atividade (CEFR, `$lib/atividades/nivel.ts`).
  /// É um RÓTULO para organizar, filtrar e o aluno ver — não muda os exercícios
  /// gerados (docs/adr-004-modulos-e-nivel.md). Nulo = sem nível. Fica na
  /// atividade e não na versão: é metadado, como o título.
  level String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  modules     ModuleActivity[]
  moduleSends ModuleSend[]

  versions ActivityVersion[]

  /// O material colado durante a criação fica ligado à atividade, mas segue
  /// na biblioteca do professor — ver ContentUnit.activities.
  contentUnits ContentUnit[] @relation("AtividadeMaterial")

  @@index([teacherId])
  @@index([teacherId, archivedAt])
}

/// Imutável após criada — regra inviolável nº 7. Editar cria uma versão nova.
model ActivityVersion {
  id            String   @id @default(cuid())
  versionNumber Int
  createdAt     DateTime @default(now())

  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  items        Item[]
  publications Publication[]

  @@unique([activityId, versionNumber])
}

model Item {
  id              String  @id @default(cuid())
  sourceContentId String? // ContentUnit.id de origem — referência solta, null se autoria manual
  generatedBy     String? // id do gerador que produziu o item — null se autoria manual
  order           Int

  /// Descartado na etapa de revisão. O item CONTINUA no rascunho para poder
  /// ser restaurado; só não entra na versão publicada. Apagar de vez tornaria
  /// o "Restaurar" da tela impossível.
  discarded Boolean @default(false)

  // JSON — valide com Zod ao ler, nunca confie no tipo do Prisma. Forma em kernel.md "Forma do Item".
  prompt      Json
  interaction Json
  grading     Json
  locale      Json

  activityVersionId String
  activityVersion   ActivityVersion @relation(fields: [activityVersionId], references: [id], onDelete: Cascade)

  attemptItems AttemptItem[]

  @@index([activityVersionId])
}

model Publication {
  id       String @id @default(cuid())
  slug     String @unique
  settings Json // feedback ao aluno, código de acesso, etc. — validado com Zod ao ler

  createdAt DateTime @default(now())

  activityVersionId String
  activityVersion   ActivityVersion @relation(fields: [activityVersionId], references: [id])

  attempts   Attempt[]
  deliveries Delivery[]

  @@index([activityVersionId])
}

// ---------------------------------------------------------------------------
// Player — aluno anônimo, sem sessão de professor. Ver server.md "fronteira de
// segurança do Player". Repositórios próprios, sem escopo de teacherId.
// ---------------------------------------------------------------------------

model Attempt {
  id     String @id @default(cuid())
  name   String
  anonId String
  seed   String // aleatorização determinística a partir daqui — regra inviolável nº 8

  /// Quem respondeu, QUANDO se sabe. Nulo é o caminho normal: o aluno entrou
  /// pelo link aberto, digitou um nome e respondeu — e a tentativa vale igual
  /// no relatório do professor. Preenchido quando ele chegou por um link
  /// pessoal, ou quando se identificou depois e vinculou o que já tinha feito.
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  /// A conta do aluno, quando ele respondeu LOGADO. É o que faz o histórico
  /// dele sobreviver à troca de aparelho — o cookie `anonId` não sobrevive.
  /// Independente de `studentId`: dá para estar logado sem estar na chamada de
  /// ninguém (o link aberto continua aberto), e dá para estar na chamada sem
  /// ter conta.
  accountId String?
  account   StudentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// O aluno autorizou GUARDAR as gravações de fala dele para o professor
  /// ouvir. Opt-in explícito, perguntado na entrada, antes da primeira
  /// questão — e falso é o padrão: sem o "sim" a gravação é transcrita e
  /// descartada, como sempre foi.
  ///
  /// Fica na TENTATIVA e não no aluno porque é isso que a pergunta significa:
  /// ele autorizou esta atividade, neste dia. Refazer pergunta de novo.
  audioConsent Boolean @default(false)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id])

  items          AttemptItem[]
  /// Os relatos de problema mandados desta tentativa — saem junto com ela.
  problemReports ProblemReport[]

  @@index([publicationId])
  @@index([studentId])
  @@index([accountId])
}

/// O RELATO DE PROBLEMA que o aluno manda de uma questão do Player ("Relatar
/// problema"). Vai para a EQUIPE do Spokke — a intranet lê, e um aviso sai por
/// e-mail para `CONTATO_PARA` —, nunca para o professor nem para outro aluno.
///
/// `contexto` é tudo o que ajuda a achar o erro, validado ao gravar
/// (`server/relatos`): a questão como o aluno a viu (o runtime), o item de
/// autoria (com o gabarito — fica no servidor e na intranet), a resposta dele
/// NAQUELA questão, a correção refeita no servidor, o estado da tela e os dados
/// técnicos do aparelho. Sem o nome do aluno e sem IP.
///
/// É dado do aluno, e por isso tem as garantias de auth.md "Dados do aluno e
/// LGPD": ele manda porque quer, a tela diz o que vai junto, o relato vale 180
/// dias (`server/relatos/retencao.ts`, pelo worker) e sai junto com a tentativa.
model ProblemReport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// correcao | texto | audio | microfone | travou | outro
  motivo    String
  descricao String? @db.Text

  /// aberto | resolvido | descartado. Quem muda é o worker, a pedido da intranet.
  status     String    @default("aberto")
  resolvedAt DateTime?
  resolvedBy String?

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  activityId    String
  publicationId String
  itemId        String
  /// A posição da questão na versão respondida (1 é a primeira).
  itemIndex     Int
  interaction   String

  contexto Json

  @@index([status, createdAt])
  @@index([teacherId])
  @@index([attemptId])
}

model AttemptItem {
  id     String @id @default(cuid())
  answer Json
  score  Float
  ms     Int

  createdAt DateTime @default(now())

  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// O retorno do PROFESSOR sobre esta resposta. Não existe mais uma fila de
  /// correção à parte: comentar e corrigir acontecem na tela de resultados, em
  /// cima da resposta (paginas.md "Resultados"). Vale para qualquer resposta,
  /// não só `rubric` — o professor comenta o que quiser.
  comment String? @db.Text

  /// A nota que o professor deu, quando ele deu. Nula é o normal: vale o
  /// `score` automático. Guardar SEPARADO em vez de sobrescrever `score`
  /// mantém as duas verdades — o que a máquina achou e o que o professor
  /// decidiu — e é isso que deixa desfazer a correção sem recorrigir.
  reviewedScore Float?
  reviewedAt    DateTime?

  /// A gravação do aluno, quando ele autorizou guardar (`Attempt.audioConsent`).
  /// É a CHAVE no bucket, não uma URL: o objeto fica privado, e quem serve é
  /// uma rota do Studio que confere se o professor é dono da tentativa. Uma URL
  /// pública aqui seria a voz de um aluno acessível a quem tivesse o endereço.
  audioKey       String?
  /// Quando o bucket apaga a gravação. **7 dias**, contra os 10 do áudio de
  /// atividade: aquele é conteúdo do professor e se regenera sozinho, este é a
  /// voz de uma pessoa e não se recria — então vive o mínimo que ainda serve
  /// para o professor dar retorno.
  audioExpiresAt DateTime?

  /// Uma resposta por item POR TENTATIVA. Sem isto, voltar para uma questão e
  /// responder de novo criava uma segunda linha e o item contava duas vezes no
  /// relatório do professor — e um clique duplo fazia o mesmo.
  @@unique([attemptId, itemId])
  @@index([attemptId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// Fila e cobrança — ver .claude/rules/server.md e .claude/rules/billing.md
// ---------------------------------------------------------------------------

/// Poll do worker via `SELECT ... FOR UPDATE SKIP LOCKED` — ver server.md "Fila".
model Job {
  id      String @id @default(cuid())
  type    String
  payload Json
  status  String @default("pending") // pending | processing | done | failed

  attempts    Int       @default(0)
  lockedUntil DateTime?
  runAfter    DateTime  @default(now())
  lastError   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAfter])
}

/// A assinatura do professor NO GATEWAY — hoje, o `preapproval` do Mercado Pago
/// (docs/adr-002-billing.md, billing.md "Mercado Pago"). Nasce no "Assinar", com
/// o status `pending` e o link do checkout, e é o que liga o id do provedor ao
/// professor, ao plano e ao ciclo que ele escolheu: o webhook só traz o id.
///
/// `status` é o do PROVEDOR, cru (`pending` | `authorized` | `paused` |
/// `cancelled`). Não é a situação da conta — essa continua saindo das datas do
/// `Teacher` (`entitlements.ts`), que só `assinaturas.ts` escreve.
model ProviderSubscription {
  id          String   @id
  provider    String
  plano       String
  ciclo       String
  status      String
  checkoutUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
}

/// Idempotência do que o gateway manda — billing.md "As três disciplinas".
/// `id` é `<provedor>:<tipo>:<id do recurso>` (`mercadopago:fatura:6114264375`):
/// a cobrança aprovada estende o período UMA vez, por mais que a notificação
/// chegue repetida.
model ProviderEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

/// O aviso do SINO do Studio (docs/notificacoes.md). Só entra o que pede uma
/// ação do professor ou o desfecho de algo que ele começou e não está olhando —
/// o resto ele vê abrindo a tela, e avisar também seria ruído.
///
/// `key` AGRUPA: enquanto a notificação não foi lida, um evento com a mesma
/// chave a ATUALIZA (`count`, `data`, `updatedAt`) em vez de criar outra —
/// trinta alunos entrando na turma são um aviso, não trinta. Lida, a próxima
/// abre uma nova. O texto não é gravado: sai de `kind` + `data` na leitura
/// (`$lib/notificacoes`), então uma copy corrigida vale para o que já existe.
model Notification {
  id        String    @id @default(cuid())
  kind      String
  key       String
  data      Json // validado com Zod ao ler, como todo JSON (db.md)
  count     Int       @default(1)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, readAt, updatedAt])
  @@index([teacherId, key])
}

/// O que mudou na cobrança (e, depois, na escola), quem mudou e quando. Toda
/// operação de `$lib/server/billing/assinaturas.ts` grava uma linha na MESMA
/// transação da mudança — sem isso o painel não responderia "por que esta conta
/// está no Pro?".
///
/// `actor`: `sistema` | `professor` | `admin:<teacherId>` | `provedor`.
model AuditEvent {
  id        String   @id @default(cuid())
  actor     String
  type      String
  data      Json // validado com Zod ao ler, como todo JSON (db.md)
  createdAt DateTime @default(now())

  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt])
}

// ---------------------------------------------------------------------------
// Ambiente escolar (plano Scholar) — docs/adr-005-escola.md.
//
// A escola é uma ORGANIZAÇÃO dentro do produto: professores-membros usam o
// mesmo Studio, e a coordenação ganha uma área própria. O contrato da escola
// vence o plano próprio do membro enquanto vale. Cobrança por contrato, criada
// e ajustada pelo painel interno.
//
// **A coordenação vê só NÚMEROS** (decisão do dono do repositório): por
// professor e por turma, nunca nome de aluno nem resposta. O conteúdo continua
// do professor — sair da escola não leva nada dele.
// ---------------------------------------------------------------------------

model School {
  id     String @id @default(cuid())
  name   String
  /// `ativa` | `suspensa` | `encerrada`. Só `ativa` (e com contrato vigente) vale como plano.
  status String @default("ativa")
  /// Quantos professores cabem — coordenação inclusive.
  seats  Int

  /// Os limites POR PROFESSOR do contrato. O admin pode sobrescrever para um
  /// membro específico (`SchoolMembership.*Max`).
  atividadesPorProfessor Int
  materiaisPorProfessor  Int
  creditosPorProfessor   Int

  /// Fim do contrato. Nulo = sem data de fim.
  contractEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members SchoolMembership[]
  invites SchoolInvite[]
}

/// O professor DENTRO da escola. `teacherId` é único: um professor está em uma
/// escola por vez, o que deixa "qual contrato vale" sem ambiguidade.
model SchoolMembership {
  id   String @id @default(cuid())
  /// `coordenacao` | `professor`.
  role String @default("professor")

  /// Exceções de limite para ESTE professor, definidas pelo admin. Nulo = vale o da escola.
  atividadesMax Int?
  materiaisMax  Int?
  creditosMax   Int?

  createdAt DateTime @default(now())

  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId String  @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// O convite para entrar na escola. O TOKEN é a prova: foi para aquele e-mail e
/// é imprevisível (≥128 bits). Uso único e com validade.
model SchoolInvite {
  id         String    @id @default(cuid())
  email      String
  role       String    @default("professor")
  token      String    @unique
  expiresAt  DateTime
  sentAt     DateTime?
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

/// Os créditos de IA como LIVRO-RAZÃO: só lançamentos, nenhum contador
/// (docs/adr-003-ia-gemini.md). O saldo é a franquia do plano em vigor MAIS a
/// soma dos lançamentos do ciclo atual (`cicloInicio`) — então virar o mês não
/// exige escrita nenhuma (não há "reset" que possa correr mal), trocar de plano
/// no meio do ciclo vale na hora, e o saldo nunca diverge do histórico.
///
/// `refKey` torna cada movimento idempotente: o débito usa o `requestId` que o
/// cliente gerou (clique duplo = um débito só), o estorno `<requestId>:estorno`.
model CreditEntry {
  id          String   @id @default(cuid())
  /// Início do ciclo mensal a que o lançamento pertence (`$lib/billing/ciclo.ts`).
  cicloInicio DateTime
  /// Negativo gasta, positivo devolve ou concede.
  delta       Int
  motivo      String // geracao_ia | estorno | cortesia | ajuste
  refKey      String   @unique
  createdAt   DateTime @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, cicloInicio])
}

/// O pedido de plano enquanto não existe gateway de pagamento
/// (docs/adr-002-billing.md): o professor escolhe na tela de planos, a equipe
/// recebe o aviso, combina o pagamento e ATENDE pelo painel interno — que é o
/// que ativa o plano.
model PlanRequest {
  id         String    @id @default(cuid())
  plano      String // basico | pro | super
  ciclo      String // mensal | anual
  status     String    @default("pendente") // pendente | atendido | cancelado
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  /// O admin que atendeu ou cancelou (id de Teacher). Nulo quando foi o próprio professor.
  resolvedBy String?

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Turmas e alunos — ver .claude/rules/paginas.md "Turmas e alunos".
//
// A regra que rege tudo aqui: **convite e link aberto coexistem**. Cadastrar a
// turma serve para o aluno chegar com o nome certo no relatório e para o
// professor não redistribuir link toda semana — nunca para trancar quem não
// está cadastrado.
// ---------------------------------------------------------------------------

model Classroom {
  id          String  @id @default(cuid())
  name        String
  /// Tag de LanguageProfile. Só filtra atividades; não muda conteúdo nenhum.
  languageTag String?
  /// Etiqueta de cor da turma. Azul/teal/violeta/magenta/ardósia — nunca verde
  /// nem âmbar, que são a semântica de correção (design-system.md).
  color       String  @default("azul")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  students   Student[]
  deliveries Delivery[]
  modulos    ModuleClassroom[]

  @@index([teacherId])
}

/// Um aluno DENTRO de uma turma. `email` é opcional de propósito: aluno sem
/// e-mail existe na chamada e nos resultados, só não recebe convite. O mesmo
/// e-mail pode estar em duas turmas — são cadastros, não contas.
model Student {
  id    String  @id @default(cuid())
  name  String
  email String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  /// A conta do aluno, quando ele tem uma. Opcional e assim continua: a
  /// chamada é do professor e existe sem conta nenhuma. O vínculo é feito
  /// abrindo o LINK PESSOAL logado — o token é a prova de que a pessoa
  /// controla aquele e-mail, que é o que a gente não teria só casando
  /// endereços digitados.
  accountId String?
  account   StudentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// O CONVITE DE CONTA: o link que o professor manda (por e-mail ou ele mesmo)
  /// para o aluno criar a conta — ou entrar na que já tem — e ligá-la a esta
  /// ficha. Mesma lógica do link pessoal: o token (192 bits) é a prova de que o
  /// link chegou a esta pessoa. Nasce na primeira vez que alguém pede o link, e
  /// "Gerar outro link" o troca (o antigo para de valer).
  accountInviteToken  String?   @unique
  /// Quando o e-mail do convite de conta saiu (o worker marca). Nulo: não saiu.
  accountInviteSentAt DateTime?

  invites  Invite[]
  attempts Attempt[]

  @@index([teacherId])
  @@index([classroomId])
  @@index([accountId])
}

/// Um MÓDULO: coleção ordenada de atividades do professor — "Intermediário",
/// "Frutas" (docs/adr-004-modulos-e-nivel.md). N:N de propósito: a mesma
/// atividade pode estar em "Frutas" e em "Intermediário". É organização do
/// professor e uma forma de mandar várias atividades de uma vez para a turma; o
/// aluno não vê "módulo" como entidade.
model Module {
  id          String  @id @default(cuid())
  name        String
  description String?
  /// Etiqueta de cor — a mesma paleta das turmas, nunca verde nem âmbar.
  color       String  @default("azul")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  activities ModuleActivity[]
  deliveries Delivery[]
  turmas     ModuleClassroom[]

  @@index([teacherId])
}

/// A atividade dentro do módulo, na posição que o professor deu. Apagar o
/// módulo não apaga atividade nenhuma — só o vínculo.
model ModuleActivity {
  position Int
  addedAt  DateTime @default(now())

  moduleId   String
  module     Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([moduleId, activityId])
  @@index([activityId])
}

/// A turma ALOCADA ao módulo (docs/telas-modulos-professor.md 2.3). Só turma
/// alocada recebe envio do módulo, e é a alocação que põe o módulo no mapa dos
/// alunos dela. Carrega a programação de envio daquela turma.
model ModuleClassroom {
  id String @id @default(cuid())

  /// A programação (`programacaoSchema`, `$lib/modulos/programacao.ts`), validada
  /// por Zod ao ler. Nula = alocada e ainda sem programação.
  schedule Json?
  /// Pausada: nada sai até retomar, e retomar recomeça as datas de hoje.
  pausedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moduleId    String
  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  sends ModuleSend[]

  @@unique([moduleId, classroomId])
  @@index([classroomId])
}

/// Uma atividade do módulo, para UMA turma alocada, com a data em que sai e o
/// desfecho. Uma linha por (alocação, atividade): a atividade sai UMA vez por
/// turma pelo módulo, e é essa unicidade que torna o envio idempotente — o job
/// que roda duas vezes encontra a linha já `enviada`.
model ModuleSend {
  id String @id @default(cuid())

  /// programada | enviada | nao_saiu | pulada
  status   String    @default("programada")
  /// Quando sai (instante, já no fuso de Brasília).
  dueAt    DateTime
  /// Por que não saiu: `rascunho`, `arquivada` ou `audio`.
  reason   String?
  /// Quantas vezes o envio já tentou sair — teto para a re-tentativa do áudio.
  attempts Int       @default(0)
  sentAt   DateTime?
  /// E-mails enfileirados naquele envio (um por aluno com e-mail).
  emails   Int?
  /// O `Delivery.envioId` do envio que levou esta atividade.
  envioId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocationId String
  allocation   ModuleClassroom @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  activityId   String
  activity     Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([allocationId, activityId])
  @@index([status, dueAt])
}

/// O ato de mandar uma publicação para uma turma. Guardado porque o histórico
/// da turma é "o que foi enviado, quando, e quantos abriram".
model Delivery {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Envio de MÓDULO: todos os `Delivery` de um mesmo clique em "Enviar módulo"
  /// para uma turma levam o mesmo `envioId`, e é por ele que o histórico da
  /// turma agrupa ("Módulo Frutas · 4 atividades") e que o aluno recebe UM
  /// e-mail com todos os links. Nulo no envio de uma atividade só.
  envioId  String?
  moduleId String?
  module   Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  /// O envio AVISOU por e-mail? Falso quando a programação do módulo é "só
  /// disponibilizar" (`canal: 'mapa'`): os convites existem — o link pessoal e o
  /// mapa do aluno funcionam —, mas ninguém recebeu e-mail. A chamada da turma
  /// lê isto para não dizer "Enviado" a quem não recebeu nada.
  porEmail Boolean @default(true)

  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  invites Invite[]

  @@index([classroomId])
  @@index([envioId])
  @@index([publicationId])
}

/// O link pessoal de um aluno para uma publicação. `token` é a identidade do
/// aluno no Player: não existe senha, e o e-mail é o canal, não a credencial.
model Invite {
  id    String @id @default(cuid())
  token String @unique

  sentAt    DateTime?
  openedAt  DateTime?
  /// Entrega recusada pelo servidor do aluno — o único estado que pede ação.
  bouncedAt DateTime?

  createdAt DateTime @default(now())

  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, studentId])
  @@index([studentId])
}
